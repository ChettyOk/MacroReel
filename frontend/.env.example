# Optional — defaults to http://127.0.0.1:8000 in src/api.ts
# VITE_API_URL=http://127.0.0.1:8000

# Google OAuth Web client ID — same value as backend GOOGLE_CLIENT_ID
# Used for local `npm run dev` only; production Docker/Render reads /app-config.json instead.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
